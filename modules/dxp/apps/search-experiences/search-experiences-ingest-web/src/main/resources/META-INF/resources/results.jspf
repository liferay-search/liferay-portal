<%
IngestionStats ingestionStats = (IngestionStats)request.getAttribute("ingestionStats");
%>

<c:if test="<%= ingestionStats != null %>">
	<h1><liferay-ui:message key="ingestion-results" /></h1>

	<ul>
		<li>
			<strong><liferay-ui:message key="successfully-ingested-items" />:</strong> <%= ingestionStats.getIngestedItemsCount() %>
		</li>
		<li>
			<strong><liferay-ui:message key="failed-to-ingest-items" />:</strong> <%= ingestionStats.getFailedItemsCount() %>
		</li>
		<li>
			<strong><liferay-ui:message key="total-processed-items" />:</strong> <%= ingestionStats.getTotalProcessedItemsCount() %>
		</li>
		<li>
			<strong><liferay-ui:message key="time-elapsed-in-seconds" />:</strong> <%= ingestionStats.getSecondsElapsed() %>
		</li>
	</ul>

	<c:if test="<%= ingestionStats.getIngestedItemsCount() > 0 %>">
		<h2><liferay-ui:message key="items" /></h1>

		<ul>

			<%
			for (String title : ingestionStats.getIngestedTitles()) {
			%>

				<li><%= title %></li>

			<%
			}
			%>

		</ul>
	</c:if>
</c:if>