definition {

	macro addBlueprint {
		Click(locator1 = "Button#PLUS");

		PortletEntry.inputTitle(title = "${name}");

		if (isSet(description)) {
			PortletEntry.inputDescription(description = "${description}");
		}

		if (isSet(baselineClauses)) {
			LexiconCard.clickCard(card = "Baseline Clauses");
		}
		else {
			LexiconCard.clickCard(card = "All Clauses");
		}

		Button.click(button = "Create");
	}

	macro addQueryElement {
		AssertElementPresent(locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_HEADER");

		if (IsElementPresent(locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_CLEAR")) {
			Click.clickNoMouseOver(locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_CLEAR");
		}

		Type.sendKeysApplicationSearch(
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_BAR",
			value1 = "${element}");

		MouseOver(
			key_elementName = "${element}",
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_ELEMENT_NAME");

		Click.clickNoMouseOverNoWaitForVisible(
			key_elementName = "${element}",
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_ELEMENT_ADD_BUTTON");
	}

	macro configureElementDropdown {
		Click(
			dropdownName = "${dropdownName}",
			locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT_GENERIC_DROPDOWN");

		Click.clickNoMouseOver(
			dropdownName = "${dropdownName}",
			locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT_GENERIC_DROPDOWN_OPTION",
			option = "${option}");
	}

	macro createElement {
		Navigator.gotoNavItem(navItem = "Elements");

		Click(locator1 = "Button#PLUS");

		PortletEntry.inputTitle(title = "${name}");

		Button.click(button = "Create");

		if (isSet(elementTemplateJSON)) {
			Type.typeCodeMirrorEditor(
				locator1 = "SearchExperiences#ELEMENTS_ADMIN_TEMPLATE_EDITOR",
				value1 = "${elementTemplateJSON}");
		}

		if (isSet(uiConfigurationJSON)) {
			Type.typeCodeMirrorEditor(
				locator1 = "SearchExperiences#ELEMENTS_ADMIN_UI_CONFIGURATION_EDITOR",
				value1 = "${uiConfigurationJSON}");
		}

		PortletEntry.save();
	}

	macro deleteAllBlueprints {
		SearchExperiences.openSearchExperiencesAdmin();

		LexiconEntry.changeDisplayStyle(displayStyle = "list");

		if (IsElementNotPresent(locator1 = "Message#EMPTY_INFO")) {
			PortletEntry.selectAll();

			Click(
				key_text = "ellipsis",
				locator1 = "ManagementBar#ANY_ICON");

			MenuItem.clickNoError(menuItem = "Delete");

			AssertConfirm(value1 = "Are you sure you want to delete selected blueprints?");

			VerifyElementPresent(locator1 = "Message#SUCCESS");
		}
	}

	macro editBlueprint {
		LexiconEntry.gotoEntry(rowEntry = "${name}");
	}

	macro editElement {
		Navigator.gotoNavItem(navItem = "Elements");

		LexiconEntry.gotoEntry(rowEntry = "${name}");
	}

	macro getBlueprintID {
		Variables.assertDefined(parameterList = "${name}");

		var groupID = JSONGroupAPI._getGroupIdByName(groupName = "Global", site = "true");
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
				${portalURL}/api/jsonws/search.blueprint/get-group-blueprints \
					-u test@liferay.com:test \
					-d groupId=${groupID} \
					-d "start=-1" \
					-d "end=-1"
						''';

		var blueprintID = JSONCurlUtil.post("${curl}", "$.[?(@['titleCurrentValue'] == '${name}')]['blueprintId']");

		echo("## ID for Blueprint ${name}: ${blueprintID}");

		return "${blueprintID}";
	}

	macro openSearchExperiencesAdmin {
		if (!(isSet(siteURLKey))) {
			var siteURLKey = "guest";
		}

		Navigator.openWithAppendToBaseURL(urlAppend = "group/${siteURLKey}/~/control_panel/manage?p_p_id=com_liferay_search_experiences_blueprints_web_internal_portlet_BlueprintsAdminPortlet");
	}

	macro searchBlueprintsPreview {
		Type(
			locator1 = "SearchExperiences#BLUEPRINTS_PREVIEW_SEARCH_BAR",
			value1 = "${searchTerm}");

		var browserType = PropsUtil.get("browser.type");

		if ("${browserType}" == "safari") {
			Click(locator1 = "Icon#BASIC_SEARCH");
		}
		else {
			KeyPress(
				locator1 = "SearchExperiences#BLUEPRINTS_PREVIEW_SEARCH_BAR",
				value1 = "\RETURN");
		}

		WaitForLiferayEvent.initializeLiferayEventLog();
	}

	macro selectBlueprintFromOptionsWidget {
		Portlet.gotoPortletOptions(
			portletName = "Blueprints Options",
			portletOption = "Configuration");

		SelectFrame(locator1 = "IFrame#CONFIGURATION");

		Button.clickSelect();

		SelectFrameTop();

		SelectFrame(
			key_title = "Select Blueprint",
			locator1 = "IFrame#MODAL_ANY");

		var key_blueprintName = "${name}";

		AssertClick(
			locator1 = "SearchExperiences#BLUEPRINTS_OPTIONS_WIDGET_CHOOSE",
			value1 = "Choose");

		SelectFrameTop();

		SelectFrame(locator1 = "IFrame#CONFIGURATION");

		Button.clickSave();

		Alert.viewSuccessMessage();

		IFrame.closeFrame();
	}

	macro viewCopiedContent {
		WebContentNavigator.openToAddBasicArticle(
			groupName = "Guest",
			siteURLKey = "guest");

		SelectFrame.selectFrameNoLoading(locator1 = "CKEditor#BODY_FIELD_IFRAME_2");

		Click(locator1 = "CKEditor#BODY");

		RobotType.robotTypeShortcut(locator1 = "Ctrl + v");

		WaitForElementPresent(
			key_text = "${text}",
			locator1 = "CKEditor#BODY_TEXT");
	}

	macro viewDownloadedContent {
		var tempDir = PropsUtil.get("output.dir.name");

		var fileContent = FileUtil.read("${tempDir}/${fileName}");

		if (contains("${fileContent}", "${text}")) {
			echo("File ${fileName} contains text ${text}");
		}
		else {
			fail("File ${fileName} does not contain text ${text}");
		}
	}

}