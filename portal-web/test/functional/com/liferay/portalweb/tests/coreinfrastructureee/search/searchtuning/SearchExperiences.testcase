@component-name = "portal-search"
definition {

	property portal.release = "true";
	property portal.suite.search.engine = "elasticsearch7";
	property portal.upstream = "true";
	property testray.main.component.name = "Search Experiences";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			JSONUser.tearDownNonAdminUsers();

			WebContent.tearDownCP();

			SearchExperiences.deleteAllBlueprints();

			Page.tearDownCP();
		}
	}

	test AddCopyAndDeleteBlueprint {
		SearchExperiences.openSearchExperiencesAdmin();

		for (var title : list "Blueprint 1,Blueprint 2") {
			SearchExperiences.addBlueprint(name = "${title}");

			PortletEntry.save();
		}

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Copy",
			rowEntry = "Blueprint 2");

		LexiconEntry.viewEntryName(rowEntry = "Blueprint 2 (Copy)");

		LexiconEntry.delete(rowEntry = "Blueprint 1");

		LexiconEntry.viewNoEntry(rowEntry = "Blueprint 1");
	}

	test AssertNonAdminsCannotAccessSearchExperiencePortlet {
		property custom.properties = "jsonws.web.service.paths.excludes=";

		JSONWebcontent.addWebContent(
			content = "Los Angeles",
			groupName = "Guest",
			title = "Java Cafe");

		for (var userNumber : list "1,2") {
			JSONUser.addUser(
				userEmailAddress = "userea${userNumber}@liferay.com",
				userFirstName = "userfn${userNumber}",
				userLastName = "userln${userNumber}",
				userScreenName = "usersn${userNumber}");

			JSONUser.setFirstPassword(
				agreeToTermsAndAnswerReminderQuery = "true",
				requireReset = "false",
				userEmailAddress = "userea${userNumber}@liferay.com");
		}

		JSONRole.assignRoleToUser(
			roleTitle = "Administrator",
			userEmailAddress = "userea1@liferay.com");

		User.logoutPG();

		User.loginUserPG(
			password = "test",
			userEmailAddress = "userea1@liferay.com");

		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "Los Angeles Boost");

		Search.openSearchPage();

		SearchPortlets.addWidgets(searchPortletList = "Blueprints Options");

		SearchExperiences.selectBlueprintFromOptionsWidget(name = "Los Angeles Boost");

		SearchPortlets.searchEmbedded(searchTerm = "cafe");

		SearchResultPortlet.viewSearchResults(
			searchAssetTitle = "Cafe",
			searchAssetType = "Web Content Article");

		User.logoutPG();

		User.loginUserPG(
			password = "test",
			userEmailAddress = "userea2@liferay.com");

		AssertElementNotPresent(locator1 = "ControlMenu#APPLICATIONS_MENU_ICON");

		SearchExperiences.openSearchExperiencesAdmin();

		Portlet.viewNoPermissionPG();

		Search.openSearchPage();

		SearchPortlets.searchEmbedded(searchTerm = "cafe");

		SearchResultPortlet.viewSearchResults(
			searchAssetTitle = "Cafe",
			searchAssetType = "Web Content Article");
	}

	test BoostCommerceItemsForAccountGroup {
		property test.name.skip.portal.instance = "SearchExperiences#BoostCommerceItemsForAccountGroup";

		CommerceAccelerators.initializeNewSiteViaAccelerator(siteName = "Minium");

		Navigator.openSiteURL(siteName = "Minium");

		JSONCommerceAccount.addAccount(accountName = "TestAccount");

		JSONCommerceAccount.addAccountGroup(accountGroupName = "TestAccountGroup");

		JSONCommerceAccount.addAccountToAccountGroup(
			accountGroupName = "TestAccountGroup",
			accountName = "TestAccount");

		CommerceNavigator.gotoPortlet(
			category = "Product Management",
			portlet = "Products");

		CommerceProducts.searchProduct(search = "Oil Filter");

		CommerceNavigator.gotoEntry(entryName = "Oil Filter");

		CommerceEntry.gotoMenuTab(menuTab = "Visibility");

		Click(
			key_name = "Account Groups",
			locator1 = "ToggleSwitch#ENABLE_SPECIFIC_TOGGLE_SWITCH");

		ClickNoError.clickNoMouseOver(
			key_title = "Add Account Group Relation to Oil Filter",
			locator1 = "Button#BUTTON_PLUS_PRODUCT_VISIBILITY");

		SelectFrame.selectFrameNoLoading(locator1 = "IFrame#MODAL_BODY");

		Check(
			key_checkboxName = "TestAccountGroup",
			locator1 = "Checkbox#ENABLE_CHECKBOX");

		SelectFrameTop();

		Button.clickAdd();

		Button.clickPublish();

		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "My Blueprint");

		SearchExperiences.addQueryElement(element = "Boost Items for My Commerce Account Groups");

		Type(
			key_fieldLabel = "Boost",
			locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT_NUMBER_FIELD",
			value1 = "1000");

		PortletEntry.save();

		var blueprintID = SearchExperiences.getBlueprintID(name = "My Blueprint");

		Navigator.openSiteURL(siteName = "Minium");

		CommerceAcceleratorsInitializer.selectAccountFromAccountSelector(accountName = "TestAccount");

		JSONLayout.addWidgetToPrivateLayout(
			column = "1",
			groupName = "Minium",
			layoutName = "Catalog",
			widgetName = "Low Level Search Options");

		Refresh();

		SearchPortlets.configureLowLevelSearchOptions(
			attributesKey = "search.experiences.blueprint.id",
			attributesValue = "${blueprintID}");

		Type(
			locator1 = "Search#EMBEDDED_SEARCH_BAR",
			value1 = "pump brake pad kit oil");

		Button.clickSubmitButton();

		AssertTextEquals(
			key_index = "1",
			locator1 = "CommerceAccelerators#PRODUCT_CARD_NAME_BY_INDEX",
			value1 = "Oil Filter");
	}

	test BoostSearchRankingForAssetType {
		JSONWebcontent.addWebContent(
			content = "Liferay",
			groupName = "Guest",
			title = "Liferay Web Content");

		JSONBlog.addEntry(
			entryContent = "Liferay Liferay",
			entryTitle = "Liferay Blogs Entry");

		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "My Blueprint");

		Search.openSearchPage();

		SearchPortlets.addWidgets(searchPortletList = "Blueprints Options");

		SearchExperiences.selectBlueprintFromOptionsWidget(name = "My Blueprint");

		SearchPortlets.searchEmbedded(searchTerm = "liferay");

		SearchResultPortlet.viewSearchResultsSpecificOrder(resultsList = "Liferay Blogs Entry,Liferay Web Content");

		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.editBlueprint(name = "My Blueprint");

		SearchExperiences.addQueryElement(element = "Boost Asset Type");

		SearchExperiences.configureElementDropdown(
			dropdownName = "Asset Type",
			option = "Web Content Article");

		Type(
			key_fieldLabel = "Boost",
			locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT_NUMBER_FIELD",
			value1 = "1000");

		PortletEntry.save();

		Search.openSearchPage();

		SearchPortlets.searchEmbedded(searchTerm = "liferay");

		SearchResultPortlet.viewSearchResultsSpecificOrder(resultsList = "Liferay Web Content,Liferay Blogs Entry");
	}

	test BoostWithCustomElasticsearchQuery {
		JSONWebcontent.addWebContent(
			content = "Los Angeles",
			groupName = "Guest",
			title = "Delicious Food");

		JSONWebcontent.addWebContent(
			content = "",
			groupName = "Guest",
			title = "Good Food");

		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "Test Blueprint");

		SearchExperiences.addQueryElement(element = "Paste any Elasticsearch query");

		var elasticsearchQueryJSON = '''
{
	"match":
	{
		"content_en_US":
		{
			"query": "los angeles"
		}
	}
}
		''';

		Type.typeCodeMirrorEditor(
			locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT_ELASTICSEARCH_QUERY_EDITOR",
			value1 = "${elasticsearchQueryJSON}");

		SearchExperiences.configureElementDropdown(
			dropdownName = "Occur",
			option = "MUST");

		PortletEntry.save();

		Search.openSearchPage();

		SearchPortlets.addWidgets(searchPortletList = "Blueprints Options");

		SearchExperiences.selectBlueprintFromOptionsWidget(name = "Test Blueprint");

		SearchPortlets.searchEmbedded(searchTerm = "food");

		SearchResultPortlet.viewSearchResults(
			searchAssetTitle = "Delicious Food",
			searchAssetType = "Web Content Article");

		SearchResultPortlet.viewSearchResultNotPresent(
			searchAssetTitle = "Good Food",
			searchAssetType = "Web Content Article");
	}

	test CreateBaselineClausesBlueprint {
		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(
			baselineClauses = "true",
			name = "Baseline Clauses Blueprint");

		VerifyElementPresent(locator1 = "Message#SUCCESS");

		AssertElementNotPresent(locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENTS_EMPTY");

		Navigator.gotoBack();

		LexiconEntry.viewEntryName(rowEntry = "Baseline Clauses Blueprint");

		SearchExperiences.editBlueprint(name = "Baseline Clauses Blueprint");

		Navigator.gotoNavTab(navTab = "Clause Contributors");

		AssertNotChecked.assertNotCheckedNotVisible(locator1 = "SearchExperiences#BLUEPRINTS_LIFERAY_INDEXER_CLAUSES_ON_OFF_TOGGLE");

		AssertNotChecked.assertNotCheckedNotVisible(
			contributorClass = "AccountEntryKeywordQueryContributor",
			locator1 = "SearchExperiences#BLUEPRINTS_CLAUSE_CONTRIBUTOR_ON_OFF_TOGGLE");

		AssertChecked.assertCheckedNotVisible(
			contributorClass = "CTModelPreFilterContributor",
			locator1 = "SearchExperiences#BLUEPRINTS_CLAUSE_CONTRIBUTOR_ON_OFF_TOGGLE");
	}

	test DefineRolePermissions {
		property custom.properties = "jsonws.web.service.paths.excludes=";

		JSONRole.addRegularRole(
			roleKey = "Search Blueprints Admin",
			roleTitle = "Search Blueprints Admin");

		for (var resourceActionIndex : list "ACCESS_IN_CONTROL_PANEL,CONFIGURATION,PERMISSIONS,PREFERENCES,VIEW") {
			Permissions.definePermissionViaJSONAPI(
				resourceAction = "${resourceActionIndex}",
				resourceName = "com_liferay_search_experiences_blueprints_web_internal_portlet_BlueprintsAdminPortlet",
				roleTitle = "Search Blueprints Admin");
		}

		for (var resourceActionIndex : list "ADD_BLUEPRINT,ADD_ELEMENT,PERMISSIONS") {
			Permissions.definePermissionViaJSONAPI(
				resourceAction = "${resourceActionIndex}",
				resourceName = "com.liferay.search.experiences.blueprints",
				roleTitle = "Search Blueprints Admin");
		}

		for (var resourceActionIndex : list "APPLY,DELETE,PERMISSIONS,UPDATE,VIEW") {
			Permissions.definePermissionViaJSONAPI(
				resourceAction = "${resourceActionIndex}",
				resourceName = "com.liferay.search.experiences.blueprints.model.Blueprint",
				roleTitle = "Search Blueprints Admin");
		}

		for (var resourceActionIndex : list "DELETE,PERMISSIONS,UPDATE,VIEW") {
			Permissions.definePermissionViaJSONAPI(
				resourceAction = "${resourceActionIndex}",
				resourceName = "com.liferay.search.experiences.blueprints.model.Element",
				roleTitle = "Search Blueprints Admin");
		}

		Permissions.definePermissionViaJSONAPI(
			resourceAction = "VIEW_CONTROL_PANEL",
			resourceName = "90",
			roleTitle = "Search Blueprints Admin");

		JSONUser.addUser(
			userEmailAddress = "userea@liferay.com",
			userFirstName = "userfn",
			userLastName = "userln",
			userScreenName = "usersn");

		JSONUser.setFirstPassword(
			agreeToTermsAndAnswerReminderQuery = "true",
			requireReset = "false",
			userEmailAddress = "userea@liferay.com");

		JSONRole.assignRoleToUser(
			roleTitle = "Search Blueprints Admin",
			userEmailAddress = "userea@liferay.com");

		User.logoutAndLoginPG(
			userLoginEmailAddress = "userea@liferay.com",
			userLoginFullName = "userfn userln");

		ApplicationsMenu.gotoPortlet(
			category = "Search Experiences",
			panel = "Applications",
			portlet = "Blueprints");

		SearchExperiences.addBlueprint(name = "New Blueprint");

		PortletEntry.save();

		SearchExperiences.editBlueprint(name = "New Blueprint");

		Click(locator1 = "Icon#EDIT_PENCIL");

		PortletEntry.inputName(name = "Edited Blueprint");

		Button.clickDone();

		PortletEntry.save();

		LexiconEntry.delete(rowEntry = "Edited Blueprint");

		LexiconEntry.viewNoEntry(rowEntry = "Edited Blueprint");

		Navigator.gotoNavItem(navItem = "Elements");

		SearchExperiences.createElement(name = "New Element");

		SearchExperiences.editElement(name = "New Element");

		var elementTemplateJSON = '''
{
	"title": {
		"en_US": "Edited Element"
	}
}
		''';

		Type.typeCodeMirrorEditor(
			locator1 = "SearchExperiences#ELEMENTS_ADMIN_TEMPLATE_EDITOR",
			value1 = "${elementTemplateJSON}");

		PortletEntry.save();

		LexiconEntry.delete(rowEntry = "Edited Element");
	}

	test ExportAndImportBlueprint {
		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "Test Blueprint");

		SearchExperiences.addQueryElement(element = "Boost Freshness");

		PortletEntry.save();

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Export",
			rowEntry = "Test Blueprint");

		LexiconEntry.delete(
			confirmationText = "Are you sure you want to delete this? It will be deleted immediately.",
			rowEntry = "Test Blueprint");

		Click(locator1 = "Icon#HEADER_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = "Import");

		SelectFrame(locator1 = "IFrame#MODAL_BODY");

		UploadTempFile(
			locator1 = "TextInput#FILE",
			value1 = "Test Blueprint.json");

		Button.clickImport();

		VerifyElementPresent(locator1 = "Message#SUCCESS");

		SearchExperiences.editBlueprint(name = "Test Blueprint");

		AssertElementPresent(
			elementName = "Boost Freshness",
			locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT");
	}

	test ExportAndImportElement {
		SearchExperiences.openSearchExperiencesAdmin();

		var elementTemplateJSON = '''
{
	"category": "boost",
	"title": {
		"en_US": "Test Element"
	}
}
		''';

		var uiConfigurationJSON = '''
{
	"fieldSets": [
		{
			"fields": [
				{
					"label": "Test Field",
					"name": "test_field",
					"type": "number"
				}
			]
		}
	]
}
		''';

		SearchExperiences.createElement(
			elementTemplateJSON = "${elementTemplateJSON}",
			name = "Test Element",
			uiConfigurationJSON = "${uiConfigurationJSON}");

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Export",
			rowEntry = "Test Element");

		LexiconEntry.delete(
			confirmationText = "Are you sure you want to delete this? It will be deleted immediately.",
			rowEntry = "Test Element");

		Click(locator1 = "Icon#HEADER_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = "Import");

		SelectFrame(locator1 = "IFrame#MODAL_BODY");

		UploadTempFile(
			locator1 = "TextInput#FILE",
			value1 = "Test Element.json");

		Button.clickImport();

		VerifyElementPresent(locator1 = "Message#SUCCESS");

		SearchExperiences.editElement(name = "Test Element");

		AssertElementPresent(
			key_text = "'en_US': 'Test Element'",
			locator1 = "SearchExperiences#ELEMENTS_ADMIN_TEMPLATE_EDITOR");

		AssertElementPresent(
			key_text = "'label': 'Test Field'",
			locator1 = "SearchExperiences#ELEMENTS_ADMIN_UI_CONFIGURATION_EDITOR");
	}

	test HideAndShowElement {
		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "Test Blueprint");

		SearchExperiences.addQueryElement(element = "Boost Freshness");

		PortletEntry.save();

		Navigator.gotoNavItem(navItem = "Elements");

		Search.searchCP(searchTerm = "Boost Freshness");

		LexiconEntry.openEntryMenu(rowEntry = "Boost Freshness");

		MenuItem.click(menuItem = "Hide");

		AssertElementNotPresent(
			key_rowEntry = "Boost Freshness",
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");

		ManagementBar.setFilterAndOrder(filterBy = "Hidden");

		AssertElementPresent(
			key_rowEntry = "Boost Freshness",
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");

		Navigator.gotoNavItem(navItem = "Blueprints");

		SearchExperiences.editBlueprint(name = "Test Blueprint");

		AssertElementPresent(
			elementName = "Boost Freshness",
			locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT");

		Type.sendKeysApplicationSearch(
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_BAR",
			value1 = "Boost Freshness");

		AssertElementNotPresent(
			key_elementName = "Boost Freshness",
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_ELEMENT_NAME");

		Navigator.gotoBack();

		Navigator.gotoNavItem(navItem = "Elements");

		ManagementBar.setFilterAndOrder(filterBy = "Hidden");

		LexiconEntry.openEntryMenu(rowEntry = "Boost Freshness");

		MenuItem.click(menuItem = "Show");

		AssertTextEquals(
			locator1 = "Message#EMPTY_INFO",
			value1 = "No entries were found.");

		ManagementBar.setFilterAndOrder(filterBy = "Visible");

		AssertElementPresent(
			key_rowEntry = "Boost Freshness",
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");

		Navigator.gotoNavItem(navItem = "Blueprints");

		SearchExperiences.editBlueprint(name = "Test Blueprint");

		Type.sendKeysApplicationSearch(
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_BAR",
			value1 = "Boost Freshness");

		AssertElementPresent(
			key_elementName = "Boost Freshness",
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_ELEMENT_NAME");
	}

	test HideAndShowMultipleElements {
		SearchExperiences.openSearchExperiencesAdmin();

		Navigator.gotoNavItem(navItem = "Elements");

		Search.searchCP(searchTerm = "Hide");

		task ("Create a list of all Elements present on the page") {
			var list = ListUtil.newList();
			var i = "1";

			while (IsElementPresent(locator1 = "xpath=(//div[@data-qa-id='rowItemContent']//h4/a)[${i}]") && (maxIterations = "20")) {
				var elementName = selenium.getText("xpath=(//div[@data-qa-id='rowItemContent']//h4/a)[${i}]");

				ListUtil.add("${list}", "${elementName}");
				var i = ${i} + 1;
			}

			var elementsList = ListUtil.toString("${list}");

			echo("List of all Elements present: ${elementsList}");
		}

		ManagementBar.clickSelectAllCheckbox();

		Click(locator1 = "Icon#TOOLBAR_ELLIPSIS");

		MenuItem.click(menuItem = "Hide");

		AssertTextEquals(
			locator1 = "Message#EMPTY_INFO",
			value1 = "No entries were found.");

		ManagementBar.setFilterAndOrder(filterBy = "Hidden");

		for (var hiddenElement : list "${elementsList}") {
			AssertElementPresent(
				key_rowEntry = "${hiddenElement}",
				locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");
		}

		Navigator.gotoNavItem(navItem = "Blueprints");

		SearchExperiences.addBlueprint(name = "Test Blueprint");

		Type.sendKeysApplicationSearch(
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_BAR",
			value1 = "Hide");

		AssertTextEquals(
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_EMPTY",
			value1 = "No query elements found.");

		Navigator.gotoBack();

		Navigator.gotoNavItem(navItem = "Elements");

		ManagementBar.setFilterAndOrder(filterBy = "Hidden");

		ManagementBar.clickSelectAllCheckbox();

		Click(locator1 = "Icon#TOOLBAR_ELLIPSIS");

		MenuItem.click(menuItem = "Show");

		AssertTextEquals(
			locator1 = "Message#EMPTY_INFO",
			value1 = "No entries were found.");

		ManagementBar.setFilterAndOrder(filterBy = "Visible");

		for (var visibleElement : list "${elementsList}") {
			AssertElementPresent(
				key_rowEntry = "${visibleElement}",
				locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");
		}

		Navigator.gotoNavItem(navItem = "Blueprints");

		SearchExperiences.editBlueprint(name = "Test Blueprint");

		Type.sendKeysApplicationSearch(
			locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_BAR",
			value1 = "Hide");

		for (var queryElement : list "${elementsList}") {
			AssertElementPresent(
				key_elementName = "${queryElement}",
				locator1 = "SearchExperiences#BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_ELEMENT_NAME");
		}
	}

		@priority = "4"
		test HideWebContentViaCustomElement {
			JSONWebcontent.addWebContent(
				content = "",
				groupName = "Guest",
				title = "Content");

			JSONWebcontent.addWebContent(
				assetTagNames = "test",
				content = "",
				groupName = "Guest",
				title = "Test Content");

			JSONWebcontent.addWebContent(
				assetTagNames = "experimental",
				content = "",
				groupName = "Guest",
				title = "Experimental Content");

			SearchExperiences.openSearchExperiencesAdmin();

			var elementTemplateJSON = '''
	{
		"category": "hide",
		"clauses": [
			{
				"context": "query",
				"occur": "filter",
				"query": {
					"wrapper":{
						"query": {
							"bool": {
								"must_not": [
									{
										"term": {
											"assetTagNames.raw": {
												"value": "${configuration.tag1}"
											}
										}
									},
									{
										"term": {
											"assetTagNames.raw": {
												"value": "${configuration.tag2}"
											}
										}
									}
								]
							}
						}
					}
				}
			}
		],
		"conditions": {},
		"description": {
			"en_US": "Hide content with multiple specific tags"
		},
		"enabled": true,
		"icon": "hidden",
		"title": {
			"en_US": "Hide Content with Multiple Tags"
		}
	}
			''';

			var uiConfigurationJSON = '''
	{
		"fieldSets": [
			{
				"fields": [
					{
						"defaultValue": "",
						"name": "tag1",
						"label": "Tag 1",
						"type": "text"
					},
					{
						"defaultValue": "",
						"name": "tag2",
						"label": "Tag 2",
						"type": "text"
					}
				]
			}
		]
	}
			''';

			SearchExperiences.createElement(
				elementTemplateJSON = "${elementTemplateJSON}",
				name = "Hide Content with Multiple Tags",
				uiConfigurationJSON = "${uiConfigurationJSON}");

			Navigator.gotoNavItem(navItem = "Blueprints");

			SearchExperiences.addBlueprint(name = "Hide Test and Experimental Content");

			SearchExperiences.addQueryElement(element = "Hide Content with Multiple Tags");

			Type(
				key_fieldLabel = "Tag 1",
				locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT_TEXT_FIELD",
				value1 = "test");

			Type(
				key_fieldLabel = "Tag 2",
				locator1 = "SearchExperiences#BLUEPRINTS_ADDED_ELEMENT_TEXT_FIELD",
				value1 = "experimental");

			PortletEntry.save();

			Search.openSearchPage();

			SearchPortlets.addWidgets(searchPortletList = "Blueprints Options");

			SearchExperiences.selectBlueprintFromOptionsWidget(name = "Hide Test and Experimental Content");

			SearchPortlets.searchEmbedded(searchTerm = "Content");

			SearchResultPortlet.viewSearchResults(
				searchAssetTitle = "Content",
				searchAssetType = "Web Content Article");

			SearchResultPortlet.viewSearchResultNotPresent(
				searchAssetTitle = "Test Content",
				searchAssetType = "Web Content Article");

			SearchResultPortlet.viewSearchResultNotPresent(
				searchAssetTitle = "Experimental Content",
				searchAssetType = "Web Content Article");
		}

	test SearchBlueprintsByTitleAndDescription {
		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(
			description = "Blueprint Test Description",
			name = "Test Blueprint - Adminicle");

		Navigator.gotoBack();

		SearchExperiences.addBlueprint(
			description = "Serendipitous Blueprint Test Description",
			name = "Test Blueprint - Aid");

		Navigator.gotoBack();

		Search.searchCP(searchTerm = "Adminicle");

		LexiconEntry.viewEntryName(rowEntry = "Test Blueprint - Adminicle");

		LexiconEntry.viewNoEntry(rowEntry = "Test Blueprint - Aid");

		Search.searchCP(searchTerm = "Serendipitous");

		LexiconEntry.viewEntryName(rowEntry = "Test Blueprint - Aid");

		LexiconEntry.viewNoEntry(rowEntry = "Test Blueprint - Adminicle");

		Search.clearSearchResult();

		LexiconEntry.viewEntryName(rowEntry = "Test Blueprint - Adminicle");

		LexiconEntry.viewEntryName(rowEntry = "Test Blueprint - Aid");
	}

	test SortBlueprints {
		SearchExperiences.deleteAllBlueprints();

		SearchExperiences.openSearchExperiencesAdmin();

		for (var blueprintNumber : list "1,3,2") {
			SearchExperiences.addBlueprint(name = "Blueprint ${blueprintNumber}");

			PortletEntry.save();
		}

		ManagementBar.setFilterAndOrder(orderBy = "Title");

		LexiconEntry.viewEntriesSpecificOrder(entryList = "Blueprint 1,Blueprint 2,Blueprint 3");

		ManagementBar.setFilterAndOrder(orderBy = "Created");

		LexiconEntry.viewEntriesSpecificOrder(entryList = "Blueprint 2,Blueprint 3,Blueprint 1");

		SearchExperiences.editBlueprint(name = "Blueprint 1");

		SearchExperiences.addQueryElement(element = "Boost Freshness");

		PortletEntry.save();

		ManagementBar.setFilterAndOrder(orderBy = "Modified");

		LexiconEntry.viewEntriesSpecificOrder(entryList = "Blueprint 1,Blueprint 2,Blueprint 3");

		ManagementBar.toggleViewOrder();

		LexiconEntry.viewEntriesSpecificOrder(entryList = "Blueprint 3,Blueprint 2,Blueprint 1");
	}

	test ViewAssetDetailsViaBlueprintsPreview {
		JSONBlog.addEntry(
			entryContent = "banana, red apple, blueberry!",
			entryTitle = "Liferay Blogs Entry Apple");

		JSONWebcontent.addWebContent(
			content = "red apple, citrus-orange",
			groupName = "Guest",
			title = "Web Content Article Apple");

		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "My Blueprint");

		Click(locator1 = "Button#PREVIEW");

		SearchExperiences.searchBlueprintsPreview(searchTerm = "Apple");

		Click(
			key_searchAssetTitle = "Liferay Blogs Entry Apple",
			locator1 = "SearchResults#ASSET_ENTRY_TABLE_TITLE");

		var siteName = TestCase.getSiteName(siteName = "${siteName}");

		SelectWindow(locator1 = "title=View Result - ${siteName}");

		AssertTextEquals(
			locator1 = "Portlet#H4_COMPONENT_TITLE",
			value1 = "Liferay Blogs Entry Apple");

		AssertTextEquals(
			locator1 = "PageEditor#CONTENT_PAGE_TEXT_CONTENT",
			value1 = "banana, red apple, blueberry!");

		Close.closeAndSelectWindow(locator1 = "title=Edit Blueprint - ${siteName}");

		Click(
			key_searchAssetTitle = "Web Content Article Apple",
			locator1 = "SearchResults#ASSET_ENTRY_TABLE_TITLE");

		SelectWindow(locator1 = "title=View Result - ${siteName}");

		AssertTextEquals(
			locator1 = "Portlet#H4_COMPONENT_TITLE",
			value1 = "Web Content Article Apple");

		AssertTextEquals(
			locator1 = "WCD#WEB_CONTENT_CONTENT",
			value1 = "red apple, citrus-orange");
	}

	test ViewBlueprintsConfigJSONValidation {
		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "My Blueprint");

		Navigator.gotoNavTab(navTab = "Settings");

		var aggregationConfigurationJSON = '''
{
	"cardinality-test": {
		"cardinality": {
			"precision_threshold": "3000",
			"field": "assetTagNames.raw"
		}
	}
}
		''';

		Type.typeCodeMirrorEditor(
			key_configurationField = "Aggregation Configuration",
			locator1 = "SearchExperiences#BLUEPRINTS_SETTINGS_CONFIGURATION_EDITOR",
			value1 = "${aggregationConfigurationJSON}");

		PortletEntry.save();

		AssertTextEquals.assertPartialText(
			locator1 = "Modal#HEADER",
			value1 = "Warning");

		Alert.viewErrorMessage(errorMessage = "expected type: Number, found: String (Aggregation Configuration)");

		Button.clickCancel();

		Navigator.gotoBack();

		SearchExperiences.editBlueprint(name = "My Blueprint");

		Navigator.gotoNavTab(navTab = "Settings");

		AssertTextNotPresent(value1 = "cardinality-test");

		Type.typeCodeMirrorEditor(
			key_configurationField = "Aggregation Configuration",
			locator1 = "SearchExperiences#BLUEPRINTS_SETTINGS_CONFIGURATION_EDITOR",
			value1 = "${aggregationConfigurationJSON}");

		PortletEntry.save();

		Button.click(button = "Continue To Save");

		SearchExperiences.editBlueprint(name = "My Blueprint");

		Navigator.gotoNavTab(navTab = "Settings");

		AssertTextPresent(value1 = "cardinality-test");
	}

	test ViewClauseContributorsUI {
		SearchExperiences.openSearchExperiencesAdmin();

		SearchExperiences.addBlueprint(name = "All Clauses Blueprint");

		Navigator.gotoNavTab(navTab = "Clause Contributors");

		AssertElementNotPresent(locator1 = "SearchExperiences#BLUEPRINTS_CLAUSE_CONTRIBUTOR_TOGGLE_DISABLED");

		Uncheck.uncheckToggleSwitch(locator1 = "SearchExperiences#BLUEPRINTS_LIFERAY_INDEXER_CLAUSES_ON_OFF_TOGGLE");

		ManagementBar.clickSelectAllCheckbox();

		Button.click(button = "Turn Off");

		AssertElementNotPresent(locator1 = "SearchExperiences#BLUEPRINTS_CLAUSE_CONTRIBUTOR_TOGGLE_ENABLED");

		PortletEntry.save();

		SearchExperiences.editBlueprint(name = "All Clauses Blueprint");

		Navigator.gotoNavTab(navTab = "Clause Contributors");

		AssertElementNotPresent(locator1 = "SearchExperiences#BLUEPRINTS_CLAUSE_CONTRIBUTOR_TOGGLE_ENABLED");

		Check.checkToggleSwitch(locator1 = "SearchExperiences#BLUEPRINTS_LIFERAY_INDEXER_CLAUSES_ON_OFF_TOGGLE");

		ManagementBar.clickSelectAllCheckbox();

		Button.click(button = "Turn On");

		PortletEntry.save();

		SearchExperiences.editBlueprint(name = "All Clauses Blueprint");

		Navigator.gotoNavTab(navTab = "Clause Contributors");

		AssertElementNotPresent(locator1 = "SearchExperiences#BLUEPRINTS_CLAUSE_CONTRIBUTOR_TOGGLE_DISABLED");

		Button.click(button = "Reset to Baseline");

		Button.click(button = "Apply");

		AssertChecked.assertCheckedNotVisible(locator1 = "SearchExperiences#BLUEPRINTS_LIFERAY_INDEXER_CLAUSES_ON_OFF_TOGGLE");

		AssertNotChecked.assertNotCheckedNotVisible(
			contributorClass = "AccountEntryKeywordQueryContributor",
			locator1 = "SearchExperiences#BLUEPRINTS_CLAUSE_CONTRIBUTOR_ON_OFF_TOGGLE");

		AssertChecked.assertCheckedNotVisible(
			contributorClass = "CTModelPreFilterContributor",
			locator1 = "SearchExperiences#BLUEPRINTS_CLAUSE_CONTRIBUTOR_ON_OFF_TOGGLE");
	}

	test ViewCustomElementsJSONValidation {
		SearchExperiences.openSearchExperiencesAdmin();

		Navigator.gotoNavItem(navItem = "Elements");

		var elementTemplateJSON = '''
{
	"title": {
		"en_US": "My Element"
	}
}
		''';

		var uiConfigurationJSON = '''
{
	"fieldSets": [
		{
			"fields": [
				{
					"label": "Boost",
					"name": "boost",
					"type": "thisTypeDoesNotExist"
				}
			]
		}
	]
}
		''';

		SearchExperiences.createElement(
			elementTemplateJSON = "${elementTemplateJSON}",
			name = "My Element",
			uiConfigurationJSON = "${uiConfigurationJSON}");

		AssertTextEquals.assertPartialText(
			locator1 = "Modal#HEADER",
			value1 = "Warning");

		Alert.viewErrorMessage(errorMessage = "thisTypeDoesNotExist is not a valid enum value");

		Button.clickCancel();

		Navigator.gotoBack();

		SearchExperiences.editElement(name = "My Element");

		AssertTextNotPresent(value1 = "thisTypeDoesNotExist");

		Type.typeCodeMirrorEditor(
			locator1 = "SearchExperiences#ELEMENTS_ADMIN_TEMPLATE_EDITOR",
			value1 = "${elementTemplateJSON}");

		Type.typeCodeMirrorEditor(
			locator1 = "SearchExperiences#ELEMENTS_ADMIN_UI_CONFIGURATION_EDITOR",
			value1 = "${uiConfigurationJSON}");

		PortletEntry.save();

		Button.click(button = "Continue To Save");

		SearchExperiences.editElement(name = "My Element");

		AssertTextPresent(value1 = "thisTypeDoesNotExist");
	}

	test ViewElementJSONViaBlueprintsQueryBuilder {
